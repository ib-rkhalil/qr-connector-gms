# Lane this connector serves — must match the lane-controller-gms instance's own
# LANE_NUMBER, since NATS subjects are lane.{LANE_NUMBER}.*
LANE_NUMBER=1

# Internal hardware NATS bus. This connector runs directly on the host (not in
# Docker — node-hid needs raw USB access), so point it at the port GMS's
# docker-compose.yml already publishes to the host (nats: ports: "4222:4222").
NATS_URL=nats://localhost:4222

# hid (default) reads a real USB HID keyboard-emulation scanner via node-hid.
# stdin is the test-injection mode: type or pipe a token instead of scanning —
# use this to verify the NATS publish -> lane-controller-gms -> GMS decision path
# without physical hardware attached.
SCANNER_MODE=hid

# Your scanner's USB vendor/product ID (hex). The defaults below are Symbol
# Technologies' 0x05e0/0x1200 from the original driver this connector is based
# on — find your actual device's IDs with `lsusb` (see README).
SCANNER_VENDOR_ID=0x05e0
SCANNER_PRODUCT_ID=0x1200

# Only needed if this machine has TWO scanners of the same make/model (e.g. a 2-lane
# box, one scanner per lane) — vendorId/productId alone can't tell them apart, so each
# connector instance must be pinned to its own physical device via node-hid's own
# device path instead. Leave blank/unset otherwise. Find each scanner's path with:
#   qr-connector.exe --list-devices
#SCANNER_DEVICE_PATH=
